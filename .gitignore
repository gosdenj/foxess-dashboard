# The settings file holds the FoxESS password, the Open API key and the
# Octopus API key in plain text. It is written with 0600 permissions and
# must never be committed.
config.json

# Runtime state: the half-hourly history the dashboard records as it runs.
config-history.json

# The Docker setup keeps the settings file in ./config, which is mounted
# into the container. Everything in that directory is the live settings and
# its history, so none of it may be committed.
config/

# Machine-specific Docker settings (the port, the uid to run as).
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
